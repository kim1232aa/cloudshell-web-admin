#!/bin/bash
# tests/fixtures/gcloud — stand-in for the real `gcloud` CLI in tests.
# Named literally "gcloud" (not "fake_gcloud") so that prepending this
# directory to PATH actually shadows the real binary during subprocess lookup.
# Behavior is driven by argv/env only; no network, no real credentials.
#
# print-access-token succeeds for acct-a/acct-b unconditionally (pre-seeded
# "existing" test accounts), always fails for acct-broken, and otherwise
# succeeds only after a matching `auth login` run wrote a marker file — this
# mirrors real gcloud: a login that never completed leaves no valid token.
set -u

STATE="${CLOUDSDK_CONFIG:-/tmp}/fake-gcloud-auth-ok"
mkdir -p "$STATE" 2>/dev/null || true

if [ "$1" = "config" ] && [ "$2" = "configurations" ]; then
  case "$3" in
    list) echo "acct-a"; echo "acct-b"; exit 0 ;;
    describe) exit 0 ;;
    create) exit 0 ;;
    delete) exit 0 ;;
  esac
fi

if [ "$1" = "auth" ] && [ "$2" = "print-access-token" ]; then
  name="${CLOUDSDK_ACTIVE_CONFIG_NAME:-}"
  case "$name" in
    acct-broken) exit 1 ;;
    acct-a|acct-b) echo "fake-token"; exit 0 ;;
  esac
  if [ -f "$STATE/$name" ]; then
    echo "fake-token"
    exit 0
  fi
  exit 1
fi

if [ "$1" = "auth" ] && [ "$2" = "list" ]; then
  echo "fake-${CLOUDSDK_ACTIVE_CONFIG_NAME:-unknown}@example.com"
  exit 0
fi

if [ "$1" = "auth" ] && [ "$2" = "login" ]; then
  echo "Go to the following link in your browser:"
  echo "    https://accounts.google.com/o/oauth2/auth?fake=1"
  echo
  echo -n "Enter authorization code: "
  read -r code
  if [ "$code" = "GOODCODE" ]; then
    echo "You are now logged in."
    touch "$STATE/${CLOUDSDK_ACTIVE_CONFIG_NAME:-unknown}"
    exit 0
  fi
  echo "Invalid code." >&2
  exit 1
fi

exit 0
